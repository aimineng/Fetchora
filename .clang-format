# Matches the style the tree is already in: four spaces, a 100 column budget, and
# braces on their own line for functions (Qt's own convention).
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterClass: true
  AfterControlStatement: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
PointerAlignment: Right
SpaceBeforeParens: ControlStatements
SortIncludes: false
