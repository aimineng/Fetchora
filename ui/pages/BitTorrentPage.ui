<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!--
   TrackerPage - the tracker manager.

   Two lists live here: the trackers handed to every BitTorrent task (fed from the
   subscription sources below) and the blacklist that is filtered out of them.
   Health is not probed from this machine: aria2 announces by itself and logs the
   outcome, and that log is what the 健康度 / 最后探测 columns show.
 -->
 <class>BitTorrentPage</class>
 <widget class="QWidget" name="BitTorrentPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>980</width>
    <height>660</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin">
    <number>28</number>
   </property>
   <property name="topMargin">
    <number>24</number>
   </property>
   <property name="rightMargin">
    <number>28</number>
   </property>
   <property name="bottomMargin">
    <number>20</number>
   </property>
   <property name="spacing">
    <number>14</number>
   </property>
   <item>
    <layout class="QHBoxLayout" name="headerLayout">
     <property name="spacing">
      <number>12</number>
     </property>
     <item>
      <layout class="QVBoxLayout" name="titleLayout">
       <property name="spacing">
        <number>2</number>
       </property>
       <item>
        <widget class="QLabel" name="pageTitle">
         <property name="text">
          <string>Tracker</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="pageSubtitle">
         <property name="text">
          <string>订阅源合并后下发给所有 BitTorrent 任务；单个任务的 Tracker 在任务详情里编辑</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <spacer name="headerSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="FluentLineEdit" name="filterEdit">
       <property name="minimumSize">
        <size>
         <width>240</width>
         <height>0</height>
        </size>
       </property>
       <property name="placeholderText">
        <string>按 URL 过滤…</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>

   <item>
    <layout class="QHBoxLayout" name="tabLayout">
     <property name="spacing">
      <number>6</number>
     </property>
    </layout>
   </item>

   <!-- "Inject the selected trackers into every BT task" -->
   <item>
    <widget class="FluentCard" name="injectCard">
     <widget class="QWidget" name="injectBody" native="true">
      <layout class="QHBoxLayout" name="injectLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <property name="spacing">
        <number>12</number>
       </property>
       <item>
        <layout class="QVBoxLayout" name="injectTextLayout">
         <property name="spacing">
          <number>2</number>
         </property>
         <item>
          <widget class="QLabel" name="injectTitle">
           <property name="text">
            <string>注入精选 Tracker</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="injectHint">
           <property name="text">
            <string>将选中的订阅源合并后追加到所有 BT 任务</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="injectSpacer">
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>40</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="FluentSwitch" name="injectSwitch"/>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

   <!-- Source chips + the field that adds one -->
   <item>
    <widget class="QWidget" name="sourcesHost" native="true">
     <layout class="QHBoxLayout" name="sourcesLayout">
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
      <property name="spacing">
       <number>6</number>
      </property>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QTableWidget" name="trackerTable">
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>260</height>
      </size>
     </property>
     <property name="editTriggers">
      <set>QAbstractItemView::NoEditTriggers</set>
     </property>
     <property name="selectionBehavior">
      <enum>QAbstractItemView::SelectRows</enum>
     </property>
     <property name="selectionMode">
      <enum>QAbstractItemView::ExtendedSelection</enum>
     </property>
     <property name="showGrid">
      <bool>false</bool>
     </property>
     <property name="wordWrap">
      <bool>false</bool>
     </property>
     <attribute name="horizontalHeaderHighlightSections">
      <bool>false</bool>
     </attribute>
     <attribute name="verticalHeaderVisible">
      <bool>false</bool>
     </attribute>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="bottomLayout">
     <property name="spacing">
      <number>8</number>
     </property>
     <item>
      <widget class="QLabel" name="statusLabel">
       <property name="text">
        <string>尚未同步</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="bottomSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>FluentCard</class>
   <extends>QFrame</extends>
   <header>ui/FluentWidgets.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>FluentLineEdit</class>
   <extends>QLineEdit</extends>
   <header>ui/FluentInputs.h</header>
  </customwidget>
  <customwidget>
   <class>FluentSwitch</class>
   <extends>QAbstractButton</extends>
   <header>ui/FluentInputs.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
