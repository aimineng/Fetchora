<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!--
   TrackerPage - everything about a torrent's trackers, and nothing else.

   It used to be the "BitTorrent" page: a second task list (torrents only), BT
   statistics, its own add-torrent/add-magnet buttons and this editor. The list
   duplicated the downloads page, which shows every task anyway - including
   torrents - so what is left here is the part that has no other home. Adding a
   .torrent or a magnet link lives next to the other ways of adding a download.
 -->
 <class>BitTorrentPage</class>
 <widget class="QWidget" name="BitTorrentPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>980</width>
    <height>640</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin">
    <number>28</number>
   </property>
   <property name="topMargin">
    <number>24</number>
   </property>
   <property name="rightMargin">
    <number>28</number>
   </property>
   <property name="bottomMargin">
    <number>20</number>
   </property>
   <property name="spacing">
    <number>16</number>
   </property>
   <item>
    <layout class="QHBoxLayout" name="headerLayout">
     <property name="spacing">
      <number>12</number>
     </property>
     <item>
      <layout class="QVBoxLayout" name="titleLayout">
       <property name="spacing">
        <number>2</number>
       </property>
       <item>
        <widget class="QLabel" name="pageTitle">
         <property name="text">
          <string>Tracker 编辑</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="pageSubtitle">
         <property name="text">
          <string>这一份列表会下发给所有 BitTorrent 任务；单个任务的 Tracker 在任务详情里编辑</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>

   <!-- ======================== tracker editor ======================== -->
   <item>
    <widget class="FluentCard" name="trackerCard">
     <widget class="QWidget" name="trackerBody" native="true">
      <layout class="QVBoxLayout" name="trackerBodyLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <property name="spacing">
        <number>10</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="trackerHeaderLayout">
         <property name="spacing">
          <number>8</number>
         </property>
         <item>
          <widget class="QLabel" name="trackerTitle">
           <property name="text">
            <string>全局 Tracker 列表</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="trackerCountLabel">
           <property name="text">
            <string>共 0 个 Tracker</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="trackerHeaderSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QLabel" name="trackerScopeLabel">
           <property name="text">
            <string>应用于所有 BitTorrent 任务</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="trackerList">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>240</height>
          </size>
         </property>
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <property name="lineWrapMode">
          <enum>QPlainTextEdit::NoWrap</enum>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="trackerHint">
         <property name="text">
          <string>该任务还没有 Tracker，添加后可以更快找到其他节点</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="trackerInputLayout">
         <property name="spacing">
          <number>8</number>
         </property>
         <item>
          <widget class="FluentLineEdit" name="trackerEdit">
           <property name="placeholderText">
            <string>添加 Tracker：udp:// 或 https:// .../announce</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>FluentCard</class>
   <extends>QFrame</extends>
   <header>ui/FluentWidgets.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>FluentLineEdit</class>
   <extends>QLineEdit</extends>
   <header>ui/FluentInputs.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
