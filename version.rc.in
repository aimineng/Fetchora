#include <windows.h>

/*
    version.rc - the Windows resource script for the executable.

    Gives Explorer, the taskbar, Alt+Tab and Task Manager a real icon and
    proper file properties. The icon bytes come from app.ico (a multi-size
    Vista+ icon holding 16/20/24/32/40/48/64/128/256 px PNG entries).

    CMake fills in the version/product placeholders below via
    configure_file(); this file is compiled as UTF-8 (--codepage=65001).
    Note: do not spell out the placeholder syntax anywhere in this file,
    configure_file() would substitute it here too.
*/

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @APP_COMMA_VERSION@
 PRODUCTVERSION  @APP_COMMA_VERSION@
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0x0804 = Simplified Chinese, 1200 = Unicode codepage */
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "@APP_PRODUCT_NAME@"
            VALUE "FileDescription",  "Fetchora"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@PROJECT_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) 2024-2025 Fetchora contributors"
            VALUE "OriginalFilename", "Fetchora.exe"
            VALUE "ProductName",      "@APP_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

/* Application icon: the lowest-numbered ICON resource becomes the shell icon. */
IDI_APPICON ICON "app.ico"
